rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; }
    match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.customerUID == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.totalAmount is number && request.resource.data.totalAmount > 0
        && request.resource.data.items.size() > 0;
      allow read: if isAdmin() || resource.data.customerUID == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}
