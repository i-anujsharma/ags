rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: read/write own document only ───────────────────
    match /users/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == "customer";
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(["role"]);
    }

    // ── Products: anyone can read, only admin can write ───────
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "anuj7harma@gmail.com";
    }

    // ── Orders: logged-in users create, admin reads all ───────
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null
                    && (request.auth.token.email == "anuj7harma@gmail.com"
                        || resource.data.customerUID == request.auth.uid);
      allow update, delete: if request.auth != null
                            && request.auth.token.email == "anuj7harma@gmail.com";
    }
  }
}